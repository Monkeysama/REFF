# 配置期生成 Windows RCDATA 和只读索引；字节保留原样，由宿主模块持有整个进程寿命。
file(GLOB_RECURSE REFF_WEB_ASSETS CONFIGURE_DEPENDS "${REFF_ROOT}/web/shell/dist/*")
if(NOT EXISTS "${REFF_ROOT}/web/shell/dist/index.html")
  message(FATAL_ERROR "请先运行 tools/build-web.ps1，再构建包含官方网页的宿主")
endif()
set(REFF_EMBED_DIR "${CMAKE_CURRENT_BINARY_DIR}/embedded")
file(MAKE_DIRECTORY "${REFF_EMBED_DIR}")
set(rc "#include <windows.h>\n")
set(index "// 自动生成：官方资源索引，勿手工修改。\n")
set(id 1000)
foreach(source IN LISTS REFF_WEB_ASSETS)
  if(IS_DIRECTORY "${source}")
    continue()
  endif()
  file(RELATIVE_PATH name "${REFF_ROOT}/web/shell/dist" "${source}")
  math(EXPR id "${id}+1")
  string(APPEND rc "${id} RCDATA \"${source}\"\n")
  string(APPEND index "{\"${name}\", ${id}},\n")
endforeach()
foreach(name IN ITEMS version.json dependencies.lock.json)
  math(EXPR id "${id}+1")
  string(APPEND rc "${id} RCDATA \"${REFF_ROOT}/${name}\"\n")
  string(APPEND index "{\"${name}\", ${id}},\n")
endforeach()
file(WRITE "${REFF_EMBED_DIR}/resources.rc" "${rc}")
file(WRITE "${REFF_EMBED_DIR}/resources.inc" "${index}")
enable_language(RC)
target_sources(reff-webview2-host PRIVATE embedded.cpp "${REFF_EMBED_DIR}/resources.rc")
target_include_directories(reff-webview2-host PRIVATE "${REFF_EMBED_DIR}")
