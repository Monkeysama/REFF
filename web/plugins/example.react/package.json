{
  "name": "reff-example-react",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "sync": "powershell -ExecutionPolicy Bypass -File ../../../tools/build-and-sync.ps1 -PluginId example.react",
