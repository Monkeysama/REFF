  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9"
  }
}