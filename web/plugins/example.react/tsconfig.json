{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@reff-sdk/*": [
        "../../sdk/*"
      ],
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/client": [
        "node_modules/@types/react-dom/client.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../env.d.ts",
    "../../sdk/**/*.ts"
  ]
}