{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@reff-sdk/*": [
        "../../sdk/*"
      ],
      "vue": [
        "node_modules/vue"
      ],
      "@reff/ui": [
        "../../shared/src/index.ts"
      ],
      "element-plus": [
        "node_modules/element-plus"
      ],
      "element-plus/*": [
        "node_modules/element-plus/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../env.d.ts",
    "../../sdk/**/*.ts"
  ]
}