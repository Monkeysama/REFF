{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["../shell/node_modules/vue"],
      "@reff/ui": ["../shared/src/index.ts"],
      "@reff-sdk/*": ["../sdk/*"],
      "element-plus": ["../shell/node_modules/element-plus"],
      "element-plus/*": ["../shell/node_modules/element-plus/*"]
    }
  },
  "include": ["env.d.ts", "example.*/src/**/*.ts", "example.*/src/**/*.vue", "../sdk/**/*.ts", "../shared/src/**/*.ts"]
}
